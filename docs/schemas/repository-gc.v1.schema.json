{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hushrun/hushrun/spec/schemas/repository-gc.v1.schema.json",
  "title": "hushrun.repository.gc/v1",
  "description": "Output of `hushrun repository gc --format json` (L-9). With dryRun, `deleted` lists what would be deleted and nothing was.",
  "type": "object",
  "required": ["schema", "ledger", "olderThan", "cutoff", "dryRun", "kept", "deleted"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "hushrun.repository.gc/v1"},
    "ledger": {"type": "string"},
    "olderThan": {"type": "string", "minLength": 1},
    "cutoff": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "dryRun": {"type": "boolean"},
    "kept": {
      "type": "object",
      "required": ["deployed", "digests"],
      "additionalProperties": false,
      "properties": {
        "deployed": {"type": "array", "items": {"type": "string", "pattern": "^v1/deployed/"}},
        "digests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["scope", "digest"],
            "additionalProperties": false,
            "properties": {
              "scope": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$"},
              "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "deleted": {"type": "array", "items": {"type": "string", "pattern": "^v1/(events|deployed)/"}}
  }
}
