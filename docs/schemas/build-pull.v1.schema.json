{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hushrun/hushrun/spec/schemas/build-pull.v1.schema.json",
  "title": "hushrun.build-pull/v1",
  "description": "Output of `hushrun build pull --format json` (B-240): the image its tag names, and whether the store was pulled, was there already, or was only resolved.",
  "type": "object",
  "required": ["schema", "outcome", "image", "tag", "digest", "reference", "to", "trust"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "hushrun.build-pull/v1"},
    "outcome": {"enum": ["pulled", "unchanged", "resolved"]},
    "image": {"type": "string", "minLength": 1},
    "tag": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reference": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"},
    "to": {"type": "string", "minLength": 1},
    "trust": {"type": ["string", "null"]}
  }
}
