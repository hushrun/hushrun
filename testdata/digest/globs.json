{
  "version": 1,
  "covers": ["D-7", "C-8"],
  "description": "Golden vectors for the scope pattern grammar (D-7). Each case lists paths the pattern must match and paths it must not, or the validation error it raises. Checked by hushrun-core's tests and by `tools/refdigest.py globs`, on Linux, macOS and Windows.",
  "cases": [
    {"pattern": "services/api/**", "matches": ["services/api/main.go", "services/api/x/y.go"], "rejects": ["services/apix/a.go", "services/api", "services/api2/a"]},
    {"pattern": "**/*.md", "matches": ["README.md", "docs/a/b.md", ".md"], "rejects": ["README.mdx", "docs/md"]},
    {"pattern": "*.go", "matches": ["main.go", ".go"], "rejects": ["cmd/main.go", "main.go/x"]},
    {"pattern": "**", "matches": ["a", "a/b", "a/b/c", ".hidden", "line\nbreak"], "rejects": []},
    {"pattern": "a/**", "matches": ["a/b", "a/b/c"], "rejects": ["a", "ab", "b/a/c"]},
    {"pattern": "**/b", "matches": ["b", "a/b", "x/y/b"], "rejects": ["ab", "b/c", "a/bb"]},
    {"pattern": "a/**/b", "matches": ["a/b", "a/x/b", "a/x/y/b"], "rejects": ["a/xb", "ab", "a/b/c"]},
    {"pattern": "**/node_modules/**", "matches": ["node_modules/x", "web/node_modules/a/b"], "rejects": ["node_modules", "web/node_modules"]},
    {"pattern": "**/**", "matches": ["a", "a/b"], "rejects": []},
    {"pattern": "a/**/**/b", "matches": ["a/b", "a/x/b", "a/x/y/b"], "rejects": ["a/xb"]},
    {"pattern": "a*", "matches": ["a", "abc", "a.b"], "rejects": ["a/b", "ba"]},
    {"pattern": "*a*", "matches": ["a", "bab", "aa"], "rejects": ["b", "x/a"]},
    {"pattern": "*", "matches": ["a", ".x"], "rejects": ["a/b"]},
    {"pattern": "?", "matches": ["a", "é", "中", "😀"], "rejects": ["ab", "", "a/b"]},
    {"pattern": "?.txt", "matches": ["a.txt", "é.txt"], "rejects": ["ab.txt", ".txt"]},
    {"pattern": "a?b", "matches": ["axb", "a b", "a\\b"], "rejects": ["a/b", "ab", "axxb"]},
    {"pattern": "[abc]", "matches": ["a", "b", "c"], "rejects": ["d", "ab", "A"]},
    {"pattern": "[a-z]", "matches": ["a", "m", "z"], "rejects": ["A", "0", "-"]},
    {"pattern": "[!a-z]", "matches": ["A", "0", "-", "é"], "rejects": ["a", "z"]},
    {"pattern": "x[!b]y", "matches": ["xay", "x.y"], "rejects": ["xby", "x/y"]},
    {"pattern": "[]]", "matches": ["]"], "rejects": ["a", "[]"]},
    {"pattern": "[]a]", "matches": ["]", "a"], "rejects": ["b"]},
    {"pattern": "[!]]", "matches": ["a", "["], "rejects": ["]"]},
    {"pattern": "[-a]", "matches": ["-", "a"], "rejects": ["b"]},
    {"pattern": "[a-]", "matches": ["-", "a"], "rejects": ["b"]},
    {"pattern": "[!a-]", "matches": ["b"], "rejects": ["a", "-"]},
    {"pattern": "[!-]", "matches": ["a"], "rejects": ["-"]},
    {"pattern": "[--z]", "matches": ["-", "a", "z"], "rejects": [" "]},
    {"pattern": "[a-z-]", "matches": ["q", "-"], "rejects": ["Q"]},
    {"pattern": "[!!]", "matches": ["a"], "rejects": ["!"]},
    {"pattern": "[*?]", "matches": ["*", "?"], "rejects": ["a"]},
    {"pattern": "[[]", "matches": ["["], "rejects": ["]"]},
    {"pattern": "[à-ê]", "matches": ["à", "é", "ê"], "rejects": ["a", "ë"]},
    {"pattern": "[\\]", "matches": ["\\"], "rejects": ["/"]},
    {"pattern": "a\\b", "matches": ["a\\b"], "rejects": ["a/b", "ab"]},
    {"pattern": "a\\*", "matches": ["a\\", "a\\xyz"], "rejects": ["a/x"]},
    {"pattern": "\\", "matches": ["\\"], "rejects": ["a"]},
    {"pattern": "a.b", "matches": ["a.b"], "rejects": ["axb"]},
    {"pattern": "a+b(c)|$^#&~,", "matches": ["a+b(c)|$^#&~,"], "rejects": ["aab(c)|$^#&~,"]},
    {"pattern": "Makefile", "matches": ["Makefile"], "rejects": ["makefile", "src/Makefile"]},
    {"pattern": ".github/**", "matches": [".github/workflows/ci.yml"], "rejects": [".github", ".githubx/a"]},
    {"pattern": "café", "matches": ["café"], "rejects": ["cafe"]},

    {"pattern": "", "error": "Empty"},
    {"pattern": "/a", "error": "EmptySegment"},
    {"pattern": "a/", "error": "EmptySegment"},
    {"pattern": "/", "error": "EmptySegment"},
    {"pattern": "a//b", "error": "EmptySegment"},
    {"pattern": "a**", "error": "RecursiveWithOther"},
    {"pattern": "**b", "error": "RecursiveWithOther"},
    {"pattern": "a/***", "error": "RecursiveWithOther"},
    {"pattern": "a/**b/c", "error": "RecursiveWithOther"},
    {"pattern": "{a,b}", "error": "Brace"},
    {"pattern": "a}", "error": "Brace"},
    {"pattern": "[{]", "error": "Brace"},
    {"pattern": "[ab", "error": "UnclosedClass"},
    {"pattern": "[a/b]", "error": "UnclosedClass"},
    {"pattern": "[", "error": "UnclosedClass"},
    {"pattern": "[]", "error": "UnclosedClass"},
    {"pattern": "[!]", "error": "UnclosedClass"},
    {"pattern": "[^a]", "error": "CaretClass"},
    {"pattern": "[z-a]", "error": "InvalidRange"},
    {"pattern": "[a--]", "error": "InvalidRange"},
    {"pattern": "[a-c-e]", "error": "AmbiguousRange"}
  ]
}
